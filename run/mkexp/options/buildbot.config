#
# Settings needed for buildbot jobs
#

VERSION_ = $$Id: run/mkexp/options/buildbot.config 2 2026-01-29 21:23:47Z m221078 $$

DEFAULT_ACCOUNT = mh0156

# Use model root for all output
USER = buildbot

[files]
  [[buildbot]]
    $MODEL_DIR/run/LOG.${EXP_ID}.config.run.o = $LOG_DIR/$EXP_ID.run.*$$SLURM_JOB_ID.log

# Use a single batch job for all runs
[jobs]
  log_timestamps = false
  [[run_start]]
    log_timestamps = true
  [[run]]
    # move 'run' to end of list
    .trigger -= run
    .trigger += run
    qos = buildbot
    batch_command = $ksh
    [[[batch]]]
      deadline = now+130minutes

  [[post,mon]]
    .type = serial
